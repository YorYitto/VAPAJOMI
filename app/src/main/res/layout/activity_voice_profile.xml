<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registro de Voz del Propietario"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#02B126"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Solo la persona registrada podrá dar comandos al asistente"
            android:textSize="14sp"
            android:textColor="#757575"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <ProgressBar
            android:id="@+id/profileProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:progressTint="#02B126"
            android:progressBackgroundTint="#CCCCCC"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/profileTitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Muestra 1 de 3"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/profileInstructionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="#444444"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/profileRecordButton"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:text="Grabar primera muestra"
            android:backgroundTint="#02B126"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/profileStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#02B126"
            android:gravity="center"
            android:layout_marginBottom="32dp"
            android:minHeight="40dp" />

        <Button
            android:id="@+id/profileSaveButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Guardar perfil de voz"
            android:backgroundTint="#02B126"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/profileClearButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Borrar perfil existente"
            android:textColor="#E53935"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</ScrollView>
